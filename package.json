{
  "name": "ramifold",
  "version": "0.0.0-dev",
  "description": "Local planning tree for software projects with an AI chat per node",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ramifold": "bin/ramifold.cjs"
  },
  "files": [
    "bin",
    "dist",
    "tools/fake-claude",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start:test": "if [ -z \"$RAMIFOLD_CLAUDE_CMD\" ]; then export RAMIFOLD_AGENT=fake; fi; node bin/ramifold.cjs",
    "seed": "tsx tools/seed/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^11.0.0",
    "fastify": "^5.12.8",
    "fractional-indexing": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lucide-react": "1.79.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "playwright-core": "1.65.0"
  }
}
